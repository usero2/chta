{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chta-app",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "durable_objects": { "bindings": [{ "name": "SEED_DIRECTORY", "class_name": "SeedDirectory" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SeedDirectory"] }],
  "vars": { "SEED_MAX_SOCKETS": "1000" },
  "observability": { "enabled": false },
  "env": {
    "production": {
      "name": "chta-app-production",
      "workers_dev": false,
      "routes": [{ "pattern": "chta.app", "custom_domain": true }],
      "durable_objects": { "bindings": [{ "name": "SEED_DIRECTORY", "class_name": "SeedDirectory" }] },
      "vars": { "SEED_MAX_SOCKETS": "1000" }
    }
  }
}
