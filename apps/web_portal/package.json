{
  "name": "chta-web-portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:runtime": "node --test test/runtime.test.js",
    "build": "node scripts/build.mjs",
    "dev": "wrangler dev --ip 127.0.0.1",
    "dry-run": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "dry-run:production": "wrangler deploy --env production --dry-run --outdir .wrangler/dry-run-production"
  },
  "devDependencies": { "wrangler": "4.162.0" }
}
